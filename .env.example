# Convex populates VITE_CONVEX_URL after project configuration.
VITE_CONVEX_URL=

# Server-side secrets: set these with `npx convex env set ...`.
# FIRECRAWL_API_KEY=
# FIRECRAWL_WEBHOOK_SECRET=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=   # Optional for development only. Leave unset for direct OpenAI.
# AGENTMAIL_API_KEY=
# AGENTMAIL_WEBHOOK_SECRET=
# Auth (Convex Auth anonymous sessions):
# SITE_URL=http://localhost:5173  # production: the https://<deployment>.convex.site URL
# JWT_PRIVATE_KEY=
# JWKS=
